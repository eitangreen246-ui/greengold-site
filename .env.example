# GreenGold Bioscience — environment variables
# Copy to .env for local dev (sqlite + console email need none of these).
# In production (Railway) set these in the service dashboard.

# Django
DJANGO_SETTINGS_MODULE=greengold.settings.production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=greengoldbioscience.com,www.greengoldbioscience.com,*.up.railway.app
CSRF_TRUSTED_ORIGINS=https://greengoldbioscience.com,https://*.up.railway.app
SECURE_SSL_REDIRECT=true

# Database — Supabase Postgres (use the pooled connection string)
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres

# Email — Resend (via Anymail)
RESEND_API_KEY=re_xxxxxxxx
DEFAULT_FROM_EMAIL=GreenGold Bioscience <hello@greengoldbioscience.com>
CONTACT_TO_EMAIL=leads@greengoldbioscience.com

# Wagtail (used in admin notification emails / absolute URLs)
WAGTAILADMIN_BASE_URL=https://greengoldbioscience.com

# Media storage — Supabase Storage (S3-compatible). Leave blank to use local /media.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
